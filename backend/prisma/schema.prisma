generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                     String                   @id @default(uuid()) @db.Uuid
  name                   String
  code                   String                   @unique
  auditApprovalSoD       Boolean                  @default(true)
  users                  User[]
  memberships            OrganizationMembership[]
  roles                  Role[]
  sites                  Site[]
  meters                 Meter[]
  readings               MeterReading[]
  siteAssignments        SiteAssignment[]
  invitations            Invitation[]
  integrationCredentials IntegrationCredential[]
  tariffAssignments      TariffAssignment[]
  buildings              Building[]
  passwordResetTokens    PasswordResetToken[]
  forecastRuns           ForecastRun[]
  integrationWebhooks    IntegrationWebhook[]
  webhookOutbox          WebhookOutbox[]
  meterEnergyRollups     MeterEnergyRollup[]
  meterEnergyAggregates  MeterEnergyAggregate[]
  meterRollupTasks       MeterRollupTask[]
  forecastDrivers        ForecastDriver[]
}

model User {
  id                          String                   @id @default(uuid()) @db.Uuid
  email                       String                   @unique
  fullName                    String
  passwordHash                String
  role                        String
  active                      Boolean                  @default(true)
  organizationId              String                   @db.Uuid
  organization                Organization             @relation(fields: [organizationId], references: [id])
  siteAssignments             SiteAssignment[]
  invitationsCreated          Invitation[]
  readingRevisions            ReadingRevision[]
  meterConfigVersions         MeterConfigVersion[]
  managedSites                Site[]                   @relation("SiteManager")
  assignedAudits              EnergyAudit[]            @relation("AssignedAuditAuditor")
  passwordResetTokens         PasswordResetToken[]
  notificationPreference      NotificationPreference?
  notificationDeliveries      NotificationDelivery[]
  requestedForecastRuns       ForecastRun[]
  uploadedAuditEvidence       AuditEvidence[]
  uploadedMaintenanceEvidence MaintenanceEvidence[]
  memberships                 OrganizationMembership[]
  platformAdmin               PlatformAdmin?           @relation("PlatformAdminSubject")
  platformAdminGrants         PlatformAdmin[]          @relation("PlatformAdminGrantor")
  platformAuditEvents         PlatformAuditLog[]

  @@unique([organizationId, id])
}

model PlatformAdmin {
  userId    String   @id @db.Uuid
  user      User     @relation("PlatformAdminSubject", fields: [userId], references: [id], onDelete: Restrict)
  grantedBy String?  @db.Uuid
  grantor   User?    @relation("PlatformAdminGrantor", fields: [grantedBy], references: [id], onDelete: Restrict)
  reason    String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
}

model PlatformAuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  actor     User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  action    String
  entity    String
  entityId  String?
  details   Json?
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}

model OrganizationMembership {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userId         String       @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  role           String
  roleId         String       @db.Uuid
  roleDefinition Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  status         String       @default("ACTIVE")
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(6)

  @@unique([organizationId, userId])
  @@index([userId, status])
}

model Role {
  id             String                   @id @default(uuid()) @db.Uuid
  organizationId String                   @db.Uuid
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  code           String
  name           String
  description    String?
  scope          String                   @default("ASSIGNED_SITES")
  isSystem       Boolean                  @default(false)
  active         Boolean                  @default(true)
  memberships    OrganizationMembership[]
  invitations    Invitation[]
  permissions    RolePermission[]
  createdAt      DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime                 @updatedAt @db.Timestamptz(6)

  @@unique([organizationId, code])
  @@unique([organizationId, id])
  @@index([organizationId, active])
}

model Permission {
  id              String           @id @default(uuid()) @db.Uuid
  code            String           @unique
  module          String
  name            String
  description     String
  roleAssignments RolePermission[]
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)
  createdAt    DateTime   @default(now()) @db.Timestamptz(6)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Invitation {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  email          String
  fullName       String
  role           String
  roleId         String       @db.Uuid
  roleDefinition Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  siteIds        Json
  tokenHash      String       @unique
  expiresAt      DateTime     @db.Timestamptz(6)
  acceptedAt     DateTime?    @db.Timestamptz(6)
  revokedAt      DateTime?    @db.Timestamptz(6)
  createdBy      String       @db.Uuid
  creator        User         @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  createdAt      DateTime     @default(now())

  @@index([organizationId, email])
}

model PasswordResetToken {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userId         String       @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  tokenHash      String       @unique
  expiresAt      DateTime     @db.Timestamptz(6)
  usedAt         DateTime?    @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)

  @@index([organizationId, userId, createdAt(sort: Desc)])
}

model Site {
  id                String           @id @default(uuid()) @db.Uuid
  organizationId    String           @db.Uuid
  organization      Organization     @relation(fields: [organizationId], references: [id])
  code              String
  name              String
  type              String
  address           String
  timezone          String
  status            String           @default("ACTIVE")
  createdAt         DateTime         @default(now())
  meters            Meter[]
  assignments       SiteAssignment[]
  buildings         Building[]
  latitude          Decimal?         @db.Decimal(9, 6)
  longitude         Decimal?         @db.Decimal(10, 6)
  operatingSchedule Json?
  managerId         String?          @db.Uuid
  manager           User?            @relation("SiteManager", fields: [managerId], references: [id], onDelete: Restrict)
  forecastRuns      ForecastRun[]
  forecastDrivers   ForecastDriver[]
  emissionRegion    String?

  @@unique([organizationId, id])
  @@unique([organizationId, code])
  @@index([organizationId, managerId])
  @@index([organizationId, status])
}

model Building {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  siteId         String       @db.Uuid
  site           Site         @relation(fields: [siteId], references: [id], onDelete: Restrict)
  code           String
  name           String
  status         String       @default("ACTIVE")
  createdAt      DateTime     @default(now())
  assets         Asset[]

  @@unique([organizationId, siteId, code])
  @@index([organizationId, siteId])
}

model SiteAssignment {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userId         String       @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  siteId         String       @db.Uuid
  site           Site         @relation(fields: [siteId], references: [id], onDelete: Restrict)
  createdAt      DateTime     @default(now())

  @@unique([userId, siteId])
  @@index([organizationId, userId])
}

model Meter {
  id                    String                 @id @default(uuid()) @db.Uuid
  organizationId        String                 @db.Uuid
  organization          Organization           @relation(fields: [organizationId], references: [id])
  siteId                String                 @db.Uuid
  site                  Site                   @relation(fields: [siteId], references: [id])
  code                  String
  serialNumber          String?
  assetId               String?                @db.Uuid
  asset                 Asset?                 @relation(fields: [assetId], references: [id], onDelete: Restrict)
  installedAt           DateTime?              @db.Timestamptz(6)
  decommissionedAt      DateTime?              @db.Timestamptz(6)
  meterType             String
  metric                String
  unit                  String
  sourceType            String
  intervalMinutes       Int
  multiplier            Decimal                @db.Decimal(18, 6)
  rolloverValue         Decimal?               @db.Decimal(20, 6)
  status                String                 @default("PENDING")
  createdAt             DateTime               @default(now())
  readings              MeterReading[]
  tariffAssignments     TariffAssignment[]
  alerts                Alert[]
  configurationVersions MeterConfigVersion[]
  maintenanceEvents     MeterMaintenance[]
  forecastRuns          ForecastRun[]
  energyRollups         MeterEnergyRollup[]
  energyAggregates      MeterEnergyAggregate[]
  rollupTasks           MeterRollupTask[]

  @@unique([organizationId, code])
  @@unique([organizationId, id])
}

model MeterConfigVersion {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @db.Uuid
  meterId         String    @db.Uuid
  meter           Meter     @relation(fields: [organizationId, meterId], references: [organizationId, id], onDelete: Restrict)
  meterType       String
  metric          String
  unit            String
  sourceType      String
  intervalMinutes Int
  multiplier      Decimal   @db.Decimal(18, 6)
  rolloverValue   Decimal?  @db.Decimal(20, 6)
  effectiveFrom   DateTime  @db.Timestamptz(6)
  effectiveTo     DateTime? @db.Timestamptz(6)
  createdBy       String?   @db.Uuid
  actor           User?     @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  reason          String
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)

  @@index([organizationId, meterId, effectiveFrom(sort: Desc)])
}

model MeterMaintenance {
  id             String                @id @default(uuid()) @db.Uuid
  organizationId String                @db.Uuid
  meterId        String                @db.Uuid
  meter          Meter                 @relation(fields: [organizationId, meterId], references: [organizationId, id], onDelete: Restrict)
  category       String
  title          String
  status         String                @default("SCHEDULED")
  scheduledAt    DateTime?             @db.Timestamptz(6)
  assignedTo     String?               @db.Uuid
  startedAt      DateTime?             @db.Timestamptz(6)
  completedAt    DateTime?             @db.Timestamptz(6)
  workNotes      String?
  outcome        String?
  createdBy      String                @db.Uuid
  createdAt      DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime              @updatedAt @db.Timestamptz(6)
  evidence       MaintenanceEvidence[]

  @@unique([organizationId, id])
  @@index([organizationId, meterId, createdAt(sort: Desc)])
  @@index([organizationId, status, scheduledAt])
}

model MaintenanceEvidence {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  maintenanceId  String           @db.Uuid
  maintenance    MeterMaintenance @relation(fields: [organizationId, maintenanceId], references: [organizationId, id], onDelete: Restrict)
  uploadedBy     String           @db.Uuid
  uploader       User             @relation(fields: [uploadedBy], references: [id], onDelete: Restrict)
  fileName       String
  contentType    String
  sizeBytes      Int
  sha256         String
  storageKey     String
  scanProvider   String
  scanId         String?
  scannedAt      DateTime         @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @db.Timestamptz(6)

  @@index([organizationId, maintenanceId, createdAt(sort: Desc)])
}

model MeterReading {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @db.Uuid
  organization   Organization       @relation(fields: [organizationId], references: [id])
  meterId        String             @db.Uuid
  meter          Meter              @relation(fields: [meterId], references: [id])
  externalId     String?
  sourceType     String             @default("MANUAL")
  sourceId       String?            @db.Uuid
  source         IntegrationSource? @relation(fields: [organizationId, sourceId], references: [organizationId, id], onDelete: Restrict)
  importJobId    String?            @db.Uuid
  importJob      ImportJob?         @relation(fields: [organizationId, importJobId], references: [organizationId, id], onDelete: Restrict)
  timestamp      DateTime           @db.Timestamptz(6)
  rawValue       Decimal            @db.Decimal(20, 6)
  value          Decimal            @db.Decimal(20, 6)
  unit           String
  quality        String             @default("VALID")
  createdAt      DateTime           @default(now())
  revisions      ReadingRevision[]

  @@unique([meterId, externalId])
  @@unique([organizationId, id])
  @@index([organizationId, timestamp(sort: Desc)])
  @@index([meterId, timestamp(sort: Desc)])
}

model MeterEnergyRollup {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  meterId        String       @db.Uuid
  meter          Meter        @relation(fields: [organizationId, meterId], references: [organizationId, id], onDelete: Cascade)
  localDate      String       @db.VarChar(10)
  timezone       String
  energyKwh      Decimal      @db.Decimal(22, 6)
  readingCount   Int          @default(0)
  resetCount     Int          @default(0)
  rolloverCount  Int          @default(0)
  quality        String       @default("VALIDATED")
  updatedAt      DateTime     @updatedAt @db.Timestamptz(6)

  @@unique([organizationId, meterId, localDate])
  @@index([organizationId, localDate, meterId])
}

model MeterEnergyAggregate {
  id                   String       @id @default(uuid()) @db.Uuid
  organizationId       String       @db.Uuid
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  meterId              String       @db.Uuid
  meter                Meter        @relation(fields: [organizationId, meterId], references: [organizationId, id], onDelete: Cascade)
  granularity          String
  bucketKey            String       @db.VarChar(40)
  bucketStart          DateTime     @db.Timestamptz(6)
  localDate            String       @db.VarChar(10)
  timezone             String
  energyKwh            Decimal      @db.Decimal(22, 6)
  readingCount         Int          @default(0)
  expectedReadingCount Int          @default(0)
  completenessPercent  Decimal?     @db.Decimal(5, 2)
  resetCount           Int          @default(0)
  rolloverCount        Int          @default(0)
  quality              String       @default("VALIDATED")
  version              Int          @default(1)
  updatedAt            DateTime     @updatedAt @db.Timestamptz(6)

  @@unique([organizationId, meterId, granularity, bucketKey])
  @@index([organizationId, granularity, bucketStart, meterId])
}

model MeterRollupTask {
  id                  String       @id @default(uuid()) @db.Uuid
  organizationId      String       @db.Uuid
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  meterId             String       @db.Uuid
  meter               Meter        @relation(fields: [organizationId, meterId], references: [organizationId, id], onDelete: Cascade)
  requestedFrom       DateTime     @db.Timestamptz(6)
  generation          Int          @default(1)
  processedGeneration Int          @default(0)
  status              String       @default("QUEUED")
  attempts            Int          @default(0)
  nextAttemptAt       DateTime     @default(now()) @db.Timestamptz(6)
  lockedAt            DateTime?    @db.Timestamptz(6)
  lastError           String?
  createdAt           DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime     @updatedAt @db.Timestamptz(6)

  @@unique([organizationId, meterId])
  @@index([status, nextAttemptAt, createdAt])
}

model ReadingRevision {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  readingId      String       @db.Uuid
  reading        MeterReading @relation(fields: [organizationId, readingId], references: [organizationId, id], onDelete: Restrict)
  previousValue  Decimal      @db.Decimal(20, 6)
  correctedValue Decimal      @db.Decimal(20, 6)
  quality        String
  reason         String
  createdBy      String       @db.Uuid
  actor          User         @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)

  @@index([organizationId, readingId, createdAt(sort: Desc)])
}

model Tariff {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @db.Uuid
  name           String
  unitRate       Decimal            @db.Decimal(18, 4)
  currency       String             @default("IDR")
  tariffType     String             @default("FLAT")
  fixedCharge    Decimal            @default(0) @db.Decimal(18, 4)
  taxPercent     Decimal            @default(0) @db.Decimal(7, 4)
  effectiveFrom  DateTime           @db.Date
  effectiveTo    DateTime?          @db.Date
  createdAt      DateTime           @default(now())
  assignments    TariffAssignment[]
  rates          TariffRate[]

  @@unique([organizationId, id])
  @@unique([organizationId, name, effectiveFrom])
}

model TariffRate {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  tariffId       String   @db.Uuid
  tariff         Tariff   @relation(fields: [organizationId, tariffId], references: [organizationId, id], onDelete: Restrict)
  startMinute    Int
  endMinute      Int
  unitRate       Decimal  @db.Decimal(18, 4)
  createdAt      DateTime @default(now())

  @@unique([tariffId, startMinute])
  @@index([organizationId, tariffId])
}

model TariffAssignment {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  meterId        String       @db.Uuid
  meter          Meter        @relation(fields: [meterId], references: [id], onDelete: Restrict)
  tariffId       String       @db.Uuid
  tariff         Tariff       @relation(fields: [tariffId], references: [id], onDelete: Restrict)
  effectiveFrom  DateTime     @db.Date
  effectiveTo    DateTime?    @db.Date
  createdAt      DateTime     @default(now())

  @@index([organizationId, meterId, effectiveFrom])
}

model AlertRule {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @db.Uuid
  name            String
  metric          String
  threshold       Decimal  @db.Decimal(18, 4)
  severity        String
  scopeType       String?
  scopeId         String?  @db.Uuid
  operator        String   @default("GT")
  thresholdMax    Decimal? @db.Decimal(18, 4)
  windowMinutes   Int      @default(15)
  cooldownMinutes Int      @default(60)
  channels        Json     @default("[\"IN_APP\"]")
  assigneeId      String?  @db.Uuid
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  alerts          Alert[]
}

model Alert {
  id                     String                 @id @default(uuid()) @db.Uuid
  organizationId         String                 @db.Uuid
  ruleId                 String                 @db.Uuid
  rule                   AlertRule              @relation(fields: [ruleId], references: [id])
  meterId                String?                @db.Uuid
  meter                  Meter?                 @relation(fields: [meterId], references: [id], onDelete: Restrict)
  status                 String                 @default("OPEN")
  message                String
  triggeredAt            DateTime               @default(now())
  resolvedAt             DateTime?
  notificationDeliveries NotificationDelivery[]

  @@unique([organizationId, id])
  @@index([organizationId, status, triggeredAt(sort: Desc)])
}

model NotificationPreference {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  userId         String   @unique @db.Uuid
  user           User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  inAppEnabled   Boolean  @default(true)
  emailEnabled   Boolean  @default(false)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  @@unique([organizationId, userId])
}

model NotificationDelivery {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  alertId        String    @db.Uuid
  alert          Alert     @relation(fields: [organizationId, alertId], references: [organizationId, id], onDelete: Restrict)
  userId         String    @db.Uuid
  user           User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  channel        String
  recipientEmail String
  status         String    @default("QUEUED")
  attemptCount   Int       @default(0)
  processingAt   DateTime? @db.Timestamptz(6)
  nextAttemptAt  DateTime? @db.Timestamptz(6)
  lastError      String?
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  sentAt         DateTime? @db.Timestamptz(6)

  @@unique([alertId, channel, recipientEmail])
  @@index([status, nextAttemptAt, createdAt])
  @@index([organizationId, userId, createdAt(sort: Desc)])
}

model ForecastRun {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  siteId         String       @db.Uuid
  site           Site         @relation(fields: [organizationId, siteId], references: [organizationId, id], onDelete: Restrict)
  meterId        String?      @db.Uuid
  meter          Meter?       @relation(fields: [organizationId, meterId], references: [organizationId, id], onDelete: Restrict)
  requestedBy    String       @db.Uuid
  requester      User         @relation(fields: [requestedBy], references: [id], onDelete: Restrict)
  model          String
  parameters     Json
  result         Json
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)

  @@index([organizationId, siteId, createdAt(sort: Desc)])
  @@index([organizationId, requestedBy, createdAt(sort: Desc)])
}

model ForecastDriver {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @db.Uuid
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  siteId          String       @db.Uuid
  site            Site         @relation(fields: [organizationId, siteId], references: [organizationId, id], onDelete: Cascade)
  date            DateTime     @db.Date
  weatherIndex    Decimal?     @db.Decimal(12, 4)
  productionUnits Decimal?     @db.Decimal(18, 4)
  source          String
  sourceReference String?
  metadata        Json?
  updatedBy       String?      @db.Uuid
  createdAt       DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(6)

  @@unique([organizationId, siteId, date])
  @@index([organizationId, siteId, date])
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  userId         String?  @db.Uuid
  action         String
  entity         String
  entityId       String?
  details        Json?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt(sort: Desc)])
}

model Asset {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  siteId         String    @db.Uuid
  buildingId     String?   @db.Uuid
  building       Building? @relation(fields: [buildingId], references: [id], onDelete: Restrict)
  code           String
  name           String
  type           String
  status         String    @default("ACTIVE")
  createdAt      DateTime  @default(now())
  meters         Meter[]

  @@unique([organizationId, code])
  @@index([organizationId, siteId])
}

model ImportJob {
  id              String               @id @default(uuid()) @db.Uuid
  organizationId  String               @db.Uuid
  fileName        String
  previewCsv      String?              @db.Text
  sourceId        String?              @db.Uuid
  source          IntegrationSource?   @relation(fields: [organizationId, sourceId], references: [organizationId, id], onDelete: Restrict)
  status          String               @default("QUEUED")
  mode            String
  accepted        Int                  @default(0)
  rejected        Int                  @default(0)
  errors          Json?
  createdBy       String?              @db.Uuid
  createdAt       DateTime             @default(now())
  completedAt     DateTime?
  readings        MeterReading[]
  quarantinedRows QuarantinedReading[]

  @@unique([organizationId, id])
  @@index([organizationId, createdAt(sort: Desc)])
}

model QuarantinedReading {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  importJobId    String    @db.Uuid
  importJob      ImportJob @relation(fields: [organizationId, importJobId], references: [organizationId, id], onDelete: Restrict)
  payload        Json
  reason         String
  status         String    @default("OPEN")
  resolvedAt     DateTime? @db.Timestamptz(6)
  resolvedBy     String?   @db.Uuid
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)

  @@unique([organizationId, id])
  @@index([organizationId, status, createdAt(sort: Desc)])
}

model Baseline {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @db.Uuid
  groupId         String    @db.Uuid
  supersedesId    String?   @db.Uuid
  siteId          String    @db.Uuid
  metric          String
  startDate       DateTime  @db.Date
  endDate         DateTime  @db.Date
  value           Decimal   @db.Decimal(20, 6)
  denominator     Decimal?  @db.Decimal(20, 6)
  denominatorUnit String?
  status          String    @default("DRAFT")
  approvalNotes   String?
  approvedBy      String?   @db.Uuid
  approvedAt      DateTime? @db.Timestamptz(6)
  version         Int       @default(1)
  createdAt       DateTime  @default(now())

  @@unique([organizationId, groupId, version])
  @@index([organizationId, siteId])
}

model EnergyTarget {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  siteId         String   @db.Uuid
  metric         String
  targetValue    Decimal  @db.Decimal(20, 6)
  unit           String
  startDate      DateTime @db.Date
  endDate        DateTime @db.Date
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())

  @@index([organizationId, siteId])
}

model EnergyAudit {
  id                  String          @id @default(uuid()) @db.Uuid
  organizationId      String          @db.Uuid
  siteId              String          @db.Uuid
  title               String
  assignedAuditor     String?
  assignedAuditorId   String?         @db.Uuid
  assignedAuditorUser User?           @relation("AssignedAuditAuditor", fields: [assignedAuditorId], references: [id], onDelete: Restrict)
  scheduledAt         DateTime?
  status              String          @default("DRAFT")
  approvalComments    String?
  createdBy           String          @db.Uuid
  createdAt           DateTime        @default(now())
  findings            AuditFinding[]
  evidence            AuditEvidence[]

  @@unique([organizationId, id])
  @@index([organizationId, status])
  @@index([organizationId, assignedAuditorId, status])
}

model AuditEvidence {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @db.Uuid
  auditId        String      @db.Uuid
  audit          EnergyAudit @relation(fields: [organizationId, auditId], references: [organizationId, id], onDelete: Restrict)
  uploadedBy     String      @db.Uuid
  uploader       User        @relation(fields: [uploadedBy], references: [id], onDelete: Restrict)
  fileName       String
  contentType    String
  sizeBytes      Int
  sha256         String
  storageKey     String
  scanProvider   String
  scanId         String?
  scannedAt      DateTime    @db.Timestamptz(6)
  createdAt      DateTime    @default(now()) @db.Timestamptz(6)

  @@index([organizationId, auditId, createdAt(sort: Desc)])
}

model AuditFinding {
  id             String             @id @default(uuid()) @db.Uuid
  auditId        String             @db.Uuid
  audit          EnergyAudit        @relation(fields: [auditId], references: [id])
  severity       String
  observation    String
  recommendation String
  createdAt      DateTime           @default(now())
  actions        CorrectiveAction[]
}

model CorrectiveAction {
  id          String       @id @default(uuid()) @db.Uuid
  findingId   String       @db.Uuid
  finding     AuditFinding @relation(fields: [findingId], references: [id])
  ownerId     String?
  dueDate     DateTime?
  status      String       @default("OPEN")
  outcome     String?
  evidenceUrl String?
  createdAt   DateTime     @default(now())
}

model EmissionFactor {
  id                String    @id @default(uuid()) @db.Uuid
  organizationId    String    @db.Uuid
  region            String
  energySource      String    @default("ELECTRICITY")
  factor            Decimal   @db.Decimal(20, 10)
  unit              String
  publicationSource String
  applicableYear    Int
  sourceUrl         String
  effectiveFrom     DateTime  @db.Date
  effectiveTo       DateTime? @db.Date
  createdAt         DateTime  @default(now())

  @@index([organizationId, applicableYear])
}

model ReportJob {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  type           String
  format         String
  filters        Json
  status         String    @default("QUEUED")
  failureReason  String?
  filePath       String?
  processingAt   DateTime? @db.Timestamptz(6)
  attemptCount   Int       @default(0)
  nextAttemptAt  DateTime? @db.Timestamptz(6)
  requestedBy    String    @db.Uuid
  idempotencyKey String?
  requestHash    String?
  createdAt      DateTime  @default(now())
  completedAt    DateTime?
  expiresAt      DateTime? @db.Timestamptz(6)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([status, expiresAt])
}

model IntegrationSource {
  id                  String                  @id @default(uuid()) @db.Uuid
  organizationId      String                  @db.Uuid
  name                String
  description         String?
  type                String
  secretHash          String?
  allowedMeterIds     Json?
  allowedIpAddresses  Json                    @default("[]")
  rateLimitPerMinute  Int                     @default(60)
  rateWindowStartedAt DateTime?               @db.Timestamptz(6)
  rateWindowCount     Int                     @default(0)
  status              String                  @default("ACTIVE")
  rotatedAt           DateTime?
  createdAt           DateTime                @default(now())
  credentials         IntegrationCredential[]
  readings            MeterReading[]
  imports             ImportJob[]

  @@unique([organizationId, id])
  @@index([organizationId, status])
}

model IntegrationCredential {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sourceId       String            @db.Uuid
  source         IntegrationSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  secretHash     String            @unique
  expiresAt      DateTime?         @db.Timestamptz(6)
  createdAt      DateTime          @default(now())

  @@index([organizationId, sourceId])
}

model IntegrationWebhook {
  id              String            @id @default(uuid()) @db.Uuid
  organizationId  String            @db.Uuid
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name            String
  url             String
  events          String[]          @default([])
  secretEncrypted String
  status          String            @default("ACTIVE")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  lastDeliveredAt DateTime?         @db.Timestamptz(6)
  deliveries      WebhookDelivery[]

  @@index([organizationId, status, createdAt(sort: Desc)])
}

model WebhookDelivery {
  id           String             @id @default(uuid()) @db.Uuid
  webhookId    String             @db.Uuid
  webhook      IntegrationWebhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event        String
  status       String
  responseCode Int?
  error        String?
  createdAt    DateTime           @default(now())

  @@index([webhookId, createdAt(sort: Desc)])
}

model WebhookOutbox {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  event          String
  payload        Json
  status         String       @default("PENDING")
  attempts       Int          @default(0)
  nextAttemptAt  DateTime     @default(now()) @db.Timestamptz(6)
  lockedAt       DateTime?    @db.Timestamptz(6)
  deliveredAt    DateTime?    @db.Timestamptz(6)
  lastError      String?
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)

  @@index([status, nextAttemptAt, createdAt])
}

model WorkspaceRecord {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  module         String
  title          String
  status         String   @default("ACTIVE")
  payload        Json
  createdBy      String   @db.Uuid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, module, createdAt(sort: Desc)])
}
