# Copy to .env for local development and replace each placeholder with private values.
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/energytrack
SESSION_SECRET=replace-with-at-least-32-random-characters
NODE_ENV=development
PORT=3000
APP_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
API_PUBLIC_URL=http://127.0.0.1:3000
APP_PUBLIC_URL=http://127.0.0.1:5173
# Optional. When set, background jobs run via BullMQ on this Redis instance (FSD section 2).
# When unset, jobs run via in-process interval polling (suitable for local dev and CI).
REDIS_URL=
# Optional bootstrap grant; email must belong to an existing active user before `npm run db:seed`.
PLATFORM_ADMIN_EMAIL=
# Optional authenticated JSON mail gateway. Configure all three to send email.
EMAIL_DELIVERY_URL=
EMAIL_DELIVERY_TOKEN=
EMAIL_FROM_ADDRESS=
# Production provider selection: Resend (verified sender domain required).
# EMAIL_DELIVERY_URL=https://api.resend.com/emails
# Amazon S3: use a private bucket and least-privilege credentials.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
WEBHOOK_ENCRYPTION_KEY=
# Cloudmersive scans evidence outside this server; configure an account and API key.
EVIDENCE_SCAN_PROVIDER=
EVIDENCE_SCAN_URL=
# Set EVIDENCE_SCAN_PROVIDER=cloudmersive and EVIDENCE_SCAN_URL=https://api.cloudmersive.com/virus/scan/file for production.
EVIDENCE_SCAN_TOKEN=
# Private local storage and authenticated malware scanner for audit evidence uploads.
AUDIT_EVIDENCE_STORAGE_DIR=private/audit-evidence
AUDIT_EVIDENCE_SCAN_URL=
AUDIT_EVIDENCE_SCAN_TOKEN=
